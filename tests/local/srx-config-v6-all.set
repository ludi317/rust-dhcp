# SRX300 (Junos 25.4R1.12) — DHCPv6 + RA on irb.{1,3,5,7,9} for the ep-control
# DHCPv6 integration path this branch (MIST-202976) is a component of.
#
# Mirrors the existing IPv4 config the SRX already carries on the same IRBs
# (pool vlanN-pool + dhcp-local-server group vlanN). Each vlan gets:
#   irb.N:                2001:db8:N::1/64
#   pool vlanN-v6-pool:   2001:db8:N::100–1ff, DNS 2001:db8::53/54
#   dhcp-local-server:    dhcpv6 group vlanN-v6 interface irb.N
#   router-advertisement: interface irb.N, M-bit set, no SLAAC (A-bit off)
#
# Landing this config is a MANUAL step. Push with `commit confirmed 5` the
# first time so a mistake auto-rolls back after 5 minutes:
#
#   scp -O tests/local/srx-config-v6-all.set srx300:/var/tmp/v6-all.set
#   ssh srx300 "cli -c 'configure exclusive; load set /var/tmp/v6-all.set; commit confirmed 5'"
#   # sanity check (RA emitting, DHCPv6 listening) then:
#   ssh srx300 "cli -c 'configure exclusive; commit'"
#
# Rollback: ssh srx300 "cli -c 'rollback 1; commit'"
#
# The trust zone on the AP-facing IRBs already has
# `host-inbound-traffic system-services all`, so no zone changes are needed
# for UDP/547 (DHCPv6) or ICMPv6 (RA / NDP).
#
# Timers match tests/fixtures/kea-dhcp6.conf so a Kea-served (veth+Docker)
# lease and an SRX-served lease exhibit the same T1/T2/valid timing: 60s
# valid, 30s preferred, 20s renew (T1), 40s rebind (T2), DNS 2001:db8::53 +
# 2001:db8::54. Uses the reserved RFC 3849 documentation prefix
# (2001:db8::/32).
#
# Junos 25.4 SRX inet6 dhcp-attributes have no `domain-search` — omitted here
# (the Kea fixture at tests/fixtures/kea-dhcp6.conf still exercises the
# search-domain code path).

# --- vlan1 -------------------------------------------------------------------
set interfaces irb unit 1 family inet6 address 2001:db8:1::1/64
set access address-assignment pool vlan1-v6-pool family inet6 prefix 2001:db8:1::/64
set access address-assignment pool vlan1-v6-pool family inet6 range vlan1-v6-range low  2001:db8:1::100/128
set access address-assignment pool vlan1-v6-pool family inet6 range vlan1-v6-range high 2001:db8:1::1ff/128
set access address-assignment pool vlan1-v6-pool family inet6 dhcp-attributes dns-server 2001:db8::53
set access address-assignment pool vlan1-v6-pool family inet6 dhcp-attributes dns-server 2001:db8::54
set access address-assignment pool vlan1-v6-pool family inet6 dhcp-attributes preferred-lifetime 30
set access address-assignment pool vlan1-v6-pool family inet6 dhcp-attributes valid-lifetime    60
set access address-assignment pool vlan1-v6-pool family inet6 dhcp-attributes t1-renewal-time   20
set access address-assignment pool vlan1-v6-pool family inet6 dhcp-attributes t2-rebinding-time 40
set system services dhcp-local-server dhcpv6 group vlan1-v6 interface irb.1
set protocols router-advertisement interface irb.1 managed-configuration
set protocols router-advertisement interface irb.1 prefix 2001:db8:1::/64 no-autonomous
set protocols router-advertisement interface irb.1 max-advertisement-interval 60
set protocols router-advertisement interface irb.1 min-advertisement-interval 20

